# Copy to .env.local for local dev (Vite loads env from project root).
# Never commit .env.local or real keys.

# ── Client (Vite) ───────────────────────────────────────────────────────────
# Inlined into the bundle at build time — set for production builds / CI.
GEMINI_API_KEY=

# Optional: where the app is hosted (AI Studio / dashboards).
APP_URL=

# Vite dev server proxies /api → Express (see vite.config.ts). Express must use the same port.
API_PORT=4000

# Disable hot reload if needed (e.g. AI Studio flicker): DISABLE_HMR=true

# ── PostgreSQL (Express API) ────────────────────────────────────────────────
# Prefer DATABASE_URL for hosted Postgres (Neon, RDS, Render, etc.). When set,
# it overrides PG_* in server/db.ts.
# DATABASE_URL=postgresql://argus:changeme@localhost:5432/argus

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=argus
PG_USER=argus
PG_PASSWORD=changeme

# Browser origin calling the API (local dev: matches npm run dev → http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Docker stack: full URL users open in the browser (nginx + API CORS). Example:
# PUBLIC_ORIGIN=http://localhost:8080

# Optional: Firebase Admin / token verify on the API (path to service account JSON).
# GOOGLE_APPLICATION_CREDENTIALS=
