# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY server ./server
COPY config ./config
COPY firebase-applet-config.json ./firebase-applet-config.json

ENV NODE_ENV=production
EXPOSE 4000

CMD ["npx", "tsx", "server/index.ts"]
